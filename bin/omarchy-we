#!/usr/bin/env python3
"""Native Omarchy Wallpaper Engine library and Steam Workshop bridge."""
import argparse
import contextlib
from concurrent.futures import ThreadPoolExecutor
import fcntl
import json
import os
from pathlib import Path
import random
import re
import selectors
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from urllib.parse import urlparse
from urllib.request import Request, HTTPRedirectHandler, build_opener

APP = '431960'
PLUGIN = 'io.github.dkgamer02ai.wallpaper-engine'
HOME = Path.home()
DATA = Path(os.environ.get('XDG_DATA_HOME', HOME / '.local/share')) / 'omarchy-we'
STATE = Path(os.environ.get('XDG_STATE_HOME', HOME / '.local/state')) / 'omarchy-we'
CACHE = Path(os.environ.get('XDG_CACHE_HOME', HOME / '.cache')) / 'omarchy-we'
REPO = Path(__file__).resolve().parent.parent
CURRENT = STATE / 'current'
LIMIT = 4 * 1024 * 1024


def clean(value, limit=240):
    return ''.join(c for c in str(value or '') if c >= ' ' and c != '\x7f')[:limit]


def emit(value):
    print(json.dumps(value, ensure_ascii=False), flush=True)


def read_json(path, default=None):
    try:
        if path.stat().st_size > LIMIT:
            return default
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    with tempfile.NamedTemporaryFile(mode='w', dir=path.parent, delete=False) as f:
        f.write(value)
        temporary = Path(f.name)
    temporary.replace(path)


def need(binary):
    found = shutil.which(binary)
    if not found:
        raise RuntimeError(f'{binary} is missing; see installation instructions.')
    return found


@contextlib.contextmanager
def lock(name):
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (STATE / (name + '.lock')).open('w') as f:
        try:
            fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            raise RuntimeError('Another operation is in progress. Wait for it to finish.') from None
        yield


def run(argv, timeout=120, on_line=None):
    """Bound child output and lifetime; terminate its process group on cancellation."""
    p = subprocess.Popen(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                         stdin=subprocess.DEVNULL, start_new_session=True)
    sel = selectors.DefaultSelector()
    for stream in (p.stdout, p.stderr):
        sel.register(stream, selectors.EVENT_READ)
    chunks = {p.stdout: bytearray(), p.stderr: bytearray()}
    pending = bytearray()
    deadline = time.monotonic() + timeout
    try:
        while sel.get_map():
            if time.monotonic() > deadline:
                raise RuntimeError('Operation timed out. Check your connection and try again.')
            for key, _ in sel.select(0.2):
                data = os.read(key.fd, 65536)
                if not data:
                    sel.unregister(key.fileobj)
                    continue
                chunks[key.fileobj].extend(data)
                if sum(map(len, chunks.values())) > LIMIT:
                    raise RuntimeError('Command output exceeded the safety limit.')
                if on_line and key.fileobj is p.stdout:
                    pending.extend(data)
                    while b'\n' in pending:
                        line, _, rest = pending.partition(b'\n')
                        pending[:] = rest
                        on_line(line.decode('utf-8', 'replace'))
        code = p.wait(timeout=2)
        stdout = chunks[p.stdout].decode('utf-8', 'replace')
        stderr = chunks[p.stderr].decode('utf-8', 'replace')
        if code:
            raise RuntimeError(clean(stderr or stdout or f'Command exited {code}', 1800))
        return stdout
    finally:
        sel.close()
        if p.poll() is None:
            os.killpg(p.pid, signal.SIGTERM)
            try:
                p.wait(timeout=2)
            except subprocess.TimeoutExpired:
                os.killpg(p.pid, signal.SIGKILL)
                p.wait()
        p.stdout.close()
        p.stderr.close()


def tap(*args, timeout=120, on_line=None):
    return run([need('tapline'), *map(str, args)], timeout, on_line)


def events(raw):
    result = []
    for line in raw.splitlines():
        try:
            obj = json.loads(line)
            if isinstance(obj, dict):
                result.append(obj)
        except ValueError:
            pass
    return result


def steam_roots():
    roots = [HOME / '.local/share/Steam', HOME / '.steam/steam',
             HOME / '.var/app/com.valvesoftware.Steam/data/Steam']
    for root in roots[:]:
        try:
            text = (root / 'steamapps/libraryfolders.vdf').read_text()[:1024 * 1024]
            roots.extend(Path(p.replace('\\\\', '\\')) for p in re.findall(r'"path"\s+"([^"\n]+)"', text))
        except OSError:
            pass
    return list(dict.fromkeys(p.resolve() for p in roots))


def managed_root():
    config_home = Path(os.environ.get('XDG_CONFIG_HOME', HOME / '.config'))
    settings = read_json(config_home / 'omarchy-we/settings.json', {})
    if not isinstance(settings, dict):
        raise RuntimeError('Invalid omarchy-we/settings.json.')
    root = Path(settings.get('library', str(DATA / 'workshop'))).expanduser()
    required = settings.get('required_mount')
    if required:
        mount = Path(required).expanduser()
        if not mount.is_absolute() or not os.path.ismount(mount):
            raise RuntimeError('Wallpaper disk is not mounted: ' + str(mount) + '. Mount it before opening the library or downloading.')
        if not root.resolve().is_relative_to(mount.resolve()):
            raise RuntimeError('Configured wallpaper library must be inside required_mount.')
    if not root.is_absolute():
        raise RuntimeError('Configured wallpaper library must be an absolute path.')
    return root


def workshop_roots():
    roots = [managed_root()]
    if os.environ.get('OMARCHY_WE_WORKSHOP'):
        roots.insert(0, Path(os.environ['OMARCHY_WE_WORKSHOP']).expanduser())
    roots += [p / 'steamapps/workshop/content' / APP for p in steam_roots()]
    return roots


def safe_file(root, relative):
    if not isinstance(relative, str) or len(relative) > 1024:
        return None
    path = (root / relative).resolve()
    return path if path.is_relative_to(root.resolve()) and path.is_file() else None


def current_id():
    try:
        return CURRENT.read_text().strip()[:20]
    except OSError:
        return ''


def library():
    found = {}
    cur = current_id()
    for root in workshop_roots():
        if not root.is_dir():
            continue
        for folder in sorted(root.iterdir())[:10000]:
            if not re.fullmatch(r'[1-9][0-9]{0,19}', folder.name) or folder.name in found:
                continue
            project = read_json(folder / 'project.json', {})
            if not isinstance(project, dict) or not project:
                continue
            preview = safe_file(folder, project.get('preview', ''))
            if not preview:
                preview = next((p for p in sorted(folder.glob('preview.*')) if p.suffix.lower() in ('.jpg', '.jpeg', '.png', '.gif', '.webp') and safe_file(folder, p.name)), None)
            typ = clean(project.get('type', '?'), 20).lower()
            found[folder.name] = dict(id=folder.name, title=clean(project.get('title') or folder.name),
                                     type=typ, preview=str(preview) if preview else None,
                                     current=folder.name == cur, installed=True, path=str(folder.resolve()))
    return sorted(found.values(), key=lambda row: row['title'].casefold())


def public_entry(row):
    return {k: v for k, v in row.items() if k != 'path'}


def item_id(value):
    value = str(value)
    if not re.fullmatch(r'[1-9][0-9]{0,19}', value) or int(value) > 2**64 - 1:
        raise RuntimeError('Use a numeric Steam Workshop item ID.')
    return value


ASSET_REQUIRED_FILES = (
    'models/util/solidlayer.json',
    'materials/util/solidlayer.json',
    'shaders/genericimage.vert',
    'shaders/genericimage.frag',
)


def assets_complete(path):
    # Directory creation happens before Steam transfers content. Require real,
    # nonempty baseline model/material/shader files, not just those directories.
    try:
        return all((path / name).is_file() and (path / name).stat().st_size > 0
                   for name in ASSET_REQUIRED_FILES)
    except OSError:
        return False


def assets():
    candidates = [DATA / 'engine/assets']
    if os.environ.get('OMARCHY_WE_ASSETS'):
        candidates.insert(0, Path(os.environ['OMARCHY_WE_ASSETS']).expanduser())
    candidates += [p / 'steamapps/common/wallpaper_engine/assets' for p in steam_roots()]
    return next((p for p in candidates if assets_complete(p)), None)


def fetch_assets():
    with lock('download'):
        destination = DATA / 'engine'
        staging = DATA / '.engine.partial'
        report = events(tap('app', 'download', APP, '--dir', staging, '--path', 'assets', '--json', timeout=3600))
        completed = any(row.get('event') == 'completed' and str(row.get('app')) == APP for row in report)
        if not completed or not assets_complete(staging / 'assets'):
            raise RuntimeError('Shared scene assets are incomplete: required model/material/shader files are missing or empty. Sign in with the Steam account that owns Wallpaper Engine and retry Scene assets. Existing assets were preserved. See deps/tapline-owned-apps.patch if this repeats.')
        backup = DATA / '.engine.previous'
        if backup.exists():
            shutil.rmtree(backup)
        if destination.exists():
            destination.rename(backup)
        try:
            staging.rename(destination)
        except OSError:
            if backup.exists():
                backup.rename(destination)
            raise
        if backup.exists():
            shutil.rmtree(backup)
    return {'event': 'completed', 'message': 'Shared scene assets ready.'}


def download(wid):
    wid = item_id(wid)
    folder = managed_root() / wid
    with lock('download'):
        details = events(tap('workshop', 'info', wid, '--json'))
        item = next((x for x in details if x.get('event') == 'item' and str(x.get('item')) == wid), None)
        if not item or str(item.get('app')) != APP:
            raise RuntimeError('This item does not belong to the Wallpaper Engine Workshop.')
        staging = folder.with_name('.' + wid + '.partial')
        tap('workshop', 'download', APP, wid, '--dir', staging, '--flat', '--json', timeout=3600)
        project = read_json(staging / 'project.json', {})
        if not isinstance(project, dict) or clean(project.get('type', ''), 20).lower() not in ('scene', 'video'):
            raise RuntimeError('Downloaded, but this renderer supports Scene and Video projects only.')
        backup = folder.with_name('.' + wid + '.previous')
        if backup.exists():
            shutil.rmtree(backup)
        if folder.exists():
            folder.rename(backup)
        try:
            staging.rename(folder)
        except OSError:
            if backup.exists():
                backup.rename(folder)
            raise
        if backup.exists():
            shutil.rmtree(backup)
    return {'event': 'completed', 'message': 'Wallpaper downloaded.', 'id': wid}


PREVIEW_HOSTS = {'images.steamusercontent.com', 'steamuserimages-a.akamaihd.net', 'images.akamai.steamusercontent.com'}


def valid_preview_url(url):
    try:
        parsed = urlparse(url)
        return (parsed.scheme == 'https' and parsed.hostname in PREVIEW_HOSTS
                and parsed.port in (None, 443) and not parsed.username and not parsed.password)
    except ValueError:
        return False


class PreviewRedirect(HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if not valid_preview_url(newurl):
            raise RuntimeError('Preview redirected outside Steam image hosts.')
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def thumbnail(row):
    wid, url = row
    if not isinstance(url, str) or len(url) > 2048 or not valid_preview_url(url):
        return None
    folder = CACHE / 'previews'
    folder.mkdir(parents=True, exist_ok=True, mode=0o700)
    path = folder / (wid + '.img')
    if path.is_file() and time.time() - path.stat().st_mtime < 86400:
        return str(path)
    try:
        opener = build_opener(PreviewRedirect())
        with opener.open(Request(url, headers={'User-Agent': 'omarchy-wallpaper-engine/2'}), timeout=6) as response:
            if not valid_preview_url(response.url):
                return None
            data = response.read(2 * 1024 * 1024 + 1)
        if len(data) > 2 * 1024 * 1024:
            return None
        if not (data.startswith((b'\x89PNG\r\n\x1a\n', b'\xff\xd8\xff', b'GIF87a', b'GIF89a')) or (data.startswith(b'RIFF') and data[8:12] == b'WEBP')):
            return None
        with tempfile.NamedTemporaryFile(dir=folder, delete=False) as f:
            f.write(data)
            temporary = Path(f.name)
        temporary.replace(path)
        return str(path)
    except (OSError, ValueError, RuntimeError):
        return None


def search(query='', page=1):
    args = ['workshop', 'search', APP, '--tag-group', 'Scene,Video', '--limit', '30', '--page', str(page), '--json']
    if query.strip():
        args += ['--text', query.strip()[:200], '--sort', 'text']
    else:
        args += ['--sort', 'trend', '--days', '30']
    result = events(tap(*args))
    local_rows = {row['id']: row for row in library()}
    installed = set(local_rows)
    rows = []
    previews = []
    for row in result:
        if row.get('event') != 'result' or str(row.get('app')) != APP or len(rows) >= 30:
            continue
        try:
            wid = item_id(row.get('item'))
        except RuntimeError:
            continue
        tags = row.get('tags') if isinstance(row.get('tags'), list) else []
        # Fetch previews out of process: QML only ever receives validated local paths.
        local = local_rows.get(wid, {})
        previews.append((wid, row.get('preview_url')))
        rows.append(dict(id=wid, title=clean(row.get('title')), type='video' if 'Video' in tags else 'scene',
                         size=max(0, min(int(row.get('size') or 0), 2**63 - 1)),
                         preview=local.get('preview'), installed=wid in installed, current=wid == current_id()))
    with ThreadPoolExecutor(max_workers=6) as pool:
        for row, preview in zip(rows, pool.map(thumbnail, previews)):
            row['preview'] = row['preview'] or preview
    summary = next((x for x in result if x.get('event') == 'searched'), {})
    total = max(0, int(summary.get('total', 0)))
    return {'items': rows, 'page': page, 'total': total, 'more': page * 30 < total}


def login(json_mode):
    qr_path = CACHE / 'steam-login.png'
    CACHE.mkdir(parents=True, exist_ok=True, mode=0o700)
    with lock('login'):
        if json_mode:
            need('qrencode')
        def line_received(line):
            parsed = urlparse(line.strip())
            if parsed.scheme == 'https' and parsed.hostname == 's.team' and parsed.path.startswith('/q/') and len(line) < 2048:
                if json_mode:
                    run(['qrencode', '-o', str(qr_path), '-s', '8', '-m', '4', line.strip()])
                    emit({'event': 'qr', 'path': str(qr_path), 'message': 'Scan with the Steam mobile app and approve the sign-in.'})
            elif not json_mode:
                print(line, flush=True)
        try:
            tap('login', '--qr', timeout=330, on_line=line_received)
            if json_mode:
                emit({'event': 'completed', 'message': 'Steam sign-in complete.'})
        finally:
            qr_path.unlink(missing_ok=True)


def renderer_pid():
    data = read_json(STATE / 'renderer.json', {})
    try:
        pid = int(data['pid'])
        fields = Path(f'/proc/{pid}/stat').read_text().split(') ', 1)[1].split()
        if fields[0] == 'Z':
            return None
        start = fields[19]
        argv = Path(f'/proc/{pid}/cmdline').read_bytes().split(b'\0')
        if start == data['start'] and b'--screen-root' in argv:
            return pid
    except (OSError, ValueError, KeyError, IndexError):
        pass
    return None


def kill_renderer():
    pid = renderer_pid()
    if pid:
        os.kill(pid, signal.SIGTERM)
        for _ in range(30):
            if renderer_pid() is None:
                break
            time.sleep(.1)
        else:
            os.kill(pid, signal.SIGKILL)
    (STATE / 'renderer.json').unlink(missing_ok=True)


def background(path):
    run(['omarchy', 'theme', 'bg', 'set', str(path)], timeout=15)
    if shutil.which('owe'):
        # OWE watches the same symlink; refresh releases any previous video layer.
        with contextlib.suppress(RuntimeError):
            run(['owe', 'refresh'], timeout=5)


def resolve(query):
    rows = library()
    exact = next((r for r in rows if r['id'] == query), None)
    if exact:
        return exact
    if query.isdigit() and 1 <= int(query) <= len(rows):
        return rows[int(query) - 1]
    matches = [r for r in rows if query.casefold() in r['title'].casefold()]
    if len(matches) != 1:
        raise RuntimeError('Choose an exact Workshop ID or an unambiguous library title.')
    return matches[0]


def apply(query):
    row = resolve(query)
    if row['type'] not in ('scene', 'video'):
        raise RuntimeError('Only Scene and Video wallpapers are supported.')
    binary = need('linux-wallpaperengine')
    shared = assets()
    if row['type'] == 'scene' and not shared:
        raise RuntimeError('Shared scene assets are missing. Use “Scene assets” or run omarchy-we assets after signing in.')
    monitors = json.loads(run(['hyprctl', 'monitors', '-j'], timeout=10))
    names = [m['name'] for m in monitors if isinstance(m.get('name'), str) and not m.get('disabled')]
    if not names:
        raise RuntimeError('No active Hyprland monitor was found.')
    scaling = os.environ.get('OMARCHY_WE_SCALING', 'fill')
    if scaling not in ('fill', 'fit', 'stretch', 'default'):
        raise RuntimeError('Invalid OMARCHY_WE_SCALING.')
    argv = [binary, '--silent']
    if shared:
        argv += ['--assets-dir', str(shared)]
    fps = os.environ.get('OMARCHY_WE_FPS', '30')
    if not fps.isdigit() or not 1 <= int(fps) <= 240:
        raise RuntimeError('OMARCHY_WE_FPS must be between 1 and 240.')
    argv += ['--fps', fps]
    for name in names:
        argv += ['--screen-root', name, '--bg', row['path'], '--scaling', scaling]
    with lock('renderer'):
        STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
        current_bg = HOME / '.local/state/omarchy/current/background'
        previous = current_bg.resolve() if current_bg.exists() else None
        placeholder = REPO / 'assets/transparent.png'
        if previous and previous != placeholder:
            write(STATE / 'previous-background', str(previous))
        kill_renderer()
        # Keep diagnostics visible on failure rather than discarding renderer output.
        with (STATE / 'renderer.log').open('w') as log:
            process = subprocess.Popen(argv, stdout=log, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
        time.sleep(1)
        if process.poll() is not None:
            raise RuntimeError('Renderer failed to start. See ' + str(STATE / 'renderer.log'))
        start = Path(f'/proc/{process.pid}/stat').read_text().split(') ', 1)[1].split()[19]
        write(STATE / 'renderer.json', json.dumps({'pid': process.pid, 'start': start}))
        try:
            background(placeholder)
        except Exception:
            kill_renderer()
            raise
        write(CURRENT, row['id'])
    return {'event': 'completed', 'message': 'Wallpaper applied.', 'id': row['id']}


def stop():
    with lock('renderer'):
        kill_renderer()
        CURRENT.unlink(missing_ok=True)
        saved = STATE / 'previous-background'
        previous = Path(saved.read_text().strip()) if saved.exists() else None
        if previous and previous.is_file():
            background(previous)
        else:
            theme = HOME / '.local/state/omarchy/current/theme/backgrounds'
            fallback = next((p for p in sorted(theme.glob('*')) if p.is_file()), None)
            if fallback:
                background(fallback)
        saved.unlink(missing_ok=True)
    return {'event': 'completed', 'message': 'Live wallpaper stopped; previous background restored.'}


def current():
    row = next((r for r in library() if r['id'] == current_id()), {})
    return dict(id=row.get('id'), title=row.get('title'), type=row.get('type'), preview=row.get('preview'), running=renderer_pid() is not None)


def doctor():
    return {'renderer': bool(shutil.which('linux-wallpaperengine')), 'tapline': bool(shutil.which('tapline')),
            'qrencode': bool(shutil.which('qrencode')), 'assets': str(assets()) if assets() else None,
            'library': str(managed_root()), 'count': len(library()), 'current': current()}


def open_ui(query='', dial=False):
    payload = json.dumps({'view': 'dial' if dial else 'workshop', 'query': query[:200]})
    run(['omarchy-shell', 'shell', 'summon', PLUGIN, payload], timeout=10)


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', nargs='?', default='browse', choices=['browse','omatrix','menu','list','current','set','launch','stop','next','prev','random','search','download','assets','login','logout','account','doctor','ipc'])
    parser.add_argument('value', nargs='?', default='')
    parser.add_argument('extra', nargs='?')
    parser.add_argument('--json', action='store_true')
    parser.add_argument('--page', type=int, default=1)
    args = parser.parse_args(argv)
    command, value = args.command, args.value
    if command == 'ipc':
        command = {'entries':'list', 'picker':'browse'}.get(value, value)
        value = args.extra or ''
        args.json = True
    if command == 'version':
        emit({'ipc':1, 'tool':'omarchy-we', 'commands':['version','entries','current','set','stop','picker','search','download','login','assets','doctor']})
        return
    if command in ('browse', 'menu', 'omatrix'):
        open_ui(value, command == 'omatrix')
        return
    if command == 'login':
        login(args.json)
        return
    if command == 'list':
        result = [public_entry(r) for r in library()]
    elif command == 'search':
        result = search(value, max(1, min(args.page, 1000)))
    elif command == 'download':
        result = download(value)
    elif command == 'assets':
        result = fetch_assets()
    elif command == 'set':
        result = apply(value)
    elif command == 'launch':
        if not current_id():
            return
        result = apply(current_id())
    elif command in ('next','prev','random'):
        rows = library()
        if not rows:
            raise RuntimeError('Library is empty. Search and download a wallpaper first.')
        ids = [r['id'] for r in rows]
        index = ids.index(current_id()) if current_id() in ids else -1
        chosen = random.choice(ids) if command == 'random' else ids[(index + (1 if command == 'next' else -1)) % len(ids)]
        result = apply(chosen)
    elif command == 'stop':
        result = stop()
    elif command == 'kill':
        kill_renderer()
        return
    elif command == 'current':
        result = current()
    elif command == 'doctor':
        result = doctor()
    elif command == 'account':
        result = {'message': clean(tap('whoami'), 1800)}
    elif command == 'logout':
        tap('logout', '--all')
        result = {'event':'completed', 'message':'Saved tapline logins removed.'}
    else:
        raise RuntimeError('Unknown IPC command.')
    if args.json or command in ('search','doctor','current'):
        emit(result)
    elif isinstance(result, list):
        for n, row in enumerate(result, 1):
            print(f"{n:3}  {row['type']:6}  {row['id']:12}  {row['title']}")
    else:
        print(result.get('message', json.dumps(result)))


if __name__ == '__main__':
    # Quickshell cancels a command with SIGTERM. Unwind so no Steam child remains.
    signal.signal(signal.SIGTERM, lambda *_: (_ for _ in ()).throw(KeyboardInterrupt()))
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
    except (RuntimeError, OSError, ValueError) as error:
        print('omarchy-we: ' + clean(error, 1800), file=sys.stderr)
        sys.exit(1)
